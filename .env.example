# Copy to .env and replace every value. .env is ignored by git.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
APP_ACCESS_TOKEN=replace-with-a-long-random-token
INTERNAL_TOKEN=replace-with-a-different-long-random-token
PORT=8787
SCHEDULER_INTERVAL_SECONDS=60
DAILY_RUN_LIMIT=24
UNREAD_PAUSE_THRESHOLD=5
MONTHLY_BUDGET_MICROS=5000000
DOCUMENTS_DIR=./data/documents
KNOWLEDGE_FILE=./data/knowledge.json
KNOWLEDGE_BASES_FILE=./data/knowledge-bases.json
PUSH_FILE=./data/push.json
MAX_DOCUMENT_BYTES=5000000
MAX_IMAGE_BYTES=10000000
JSON_BODY_MAX_BYTES=16000000
KNOWLEDGE_MIN_SCORE=0.05
WEB_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
WEB_SEARCH_API_KEY=replace-with-search-provider-key
WEB_FETCH_MAX_BYTES=1000000
APNS_TEAM_ID=replace-with-apple-team-id
APNS_KEY_ID=replace-with-apns-key-id
APNS_TOPIC=local.personal.deepseek
APNS_PRIVATE_KEY=replace-with-p8-private-key-with-escaped-newlines
